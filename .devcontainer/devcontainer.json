{
  "name": "AnimeNexus OpenCode",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:1-22-bookworm",
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "AnimeNexus development server",
      "onAutoForward": "notify"
    }
  },
  "postCreateCommand": "npm install --global opencode-ai",
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    }
  }
}
