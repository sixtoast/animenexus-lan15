# ─── Site ───────────────────────────────────────────────────────
# Public site origin (OAuth redirects, sitemap, OG). Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://animenexus.vercel.app

# Recommendation intelligence V3 soft default: on | off | auto (default auto)
# NEXT_PUBLIC_REC_V3=auto

# ─── Supabase (Fan zone confessions + optional cloud) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only (desk-cloud / privileged routes) — never expose to client
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── AniList OAuth ──────────────────────────────────────────────────
# https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Must match the redirect URI registered on AniList
ANILIST_REDIRECT_URI=https://your-domain.com/api/anilist/callback

# ─── MyAnimeList OAuth ─────────────────────────────────────────────
# https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=https://your-domain.com/api/mal/callback

# ─── Web Push (VAPID) ───────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push service
VAPID_SUBJECT=mailto:you@example.com

# ─── Cron / admin push ──────────────────────────────────────────────
# vercel.json cron → /api/cron/airing-push (Authorization: Bearer)
CRON_SECRET=
# Manual /api/push/send (Authorization: Bearer only — no query secret)
PUSH_SEND_SECRET=

# ─── Error monitoring (optional) ────────────────────────────────────
# SENTRY_DSN=https://KEY@o0.ingest.sentry.io/PROJECT
# NEXT_PUBLIC_SENTRY_DSN=

# ─── AI (optional site-wide defaults; survive every redeploy) ─────
# Vercel → Project → Settings → Environment Variables
# NEXT_PUBLIC_* is visible in the browser bundle — use a restricted key.
# NEXT_PUBLIC_AI_PROVIDER=openrouter
# NEXT_PUBLIC_AI_BASE_URL=https://openrouter.ai/api/v1
# NEXT_PUBLIC_AI_MODEL=openai/gpt-4o-mini
# NEXT_PUBLIC_AI_API_KEY=sk-or-...

# ─── Cloudinary (site-owned media) ─────────────────────────────────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Motion / GIF search (optional) ─────────────────────────────────
# TENOR_API_KEY=
# GIPHY_API_KEY=

# ─── Enrichment APIs (optional) ───────────────────────────────────────
# FANART_API_KEY=
# SAUCENAO_API_KEY=
# SIMKL_CLIENT_ID=
# WATCHMODE_API_KEY=
# WATCHMODE_DEFAULT_REGION=US
# ANIMESCHEDULE_API_KEY=
# ANIDB_CLIENT=
# ANIDB_CLIENTVER=1
