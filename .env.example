# ─── Site ───────────────────────────────────────────────────────────
# Public site origin (OAuth redirects, sitemap, OG). Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=https://animenexus.vercel.app

# Recommendation intelligence V3 soft default: on | off | auto (default auto)
# NEXT_PUBLIC_REC_V3=auto

# ─── Supabase (Fan zone confessions + optional cloud) ───────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Server-only (desk-cloud / privileged routes) — never expose to client
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ─── AniList OAuth ──────────────────────────────────────────────────
# https://anilist.co/settings/developer
ANILIST_CLIENT_ID=
ANILIST_CLIENT_SECRET=
# Must match the redirect URI registered on AniList
ANILIST_REDIRECT_URI=https://your-domain.com/api/anilist/callback

# ─── MyAnimeList OAuth ──────────────────────────────────────────────
# https://myanimelist.net/apiconfig
MAL_CLIENT_ID=
MAL_CLIENT_SECRET=
MAL_REDIRECT_URI=https://your-domain.com/api/mal/callback

# ─── Web Push (VAPID) ───────────────────────────────────────────────
# Generate: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto: or https: contact for push service
VAPID_SUBJECT=mailto:you@example.com

# ─── Cron / admin push ──────────────────────────────────────────────
# vercel.json cron → /api/cron/airing-push (Authorization: Bearer)
CRON_SECRET=
# Manual /api/push/send (Authorization: Bearer only — no query secret)
PUSH_SEND_SECRET=

# ─── Error monitoring (optional) ────────────────────────────────────
# Sentry DSN — enables soft client/server reporting (no @sentry package required)
# Create a project at https://sentry.io and paste the DSN:
# SENTRY_DSN=https://KEY@o0.ingest.sentry.io/PROJECT
# NEXT_PUBLIC_SENTRY_DSN=  # same value for browser reports

# ─── Cloudinary (site-owned media) ──────────────────────────────────
# NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
# Server upload credentials (never expose):
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── Motion / GIF search (optional) ─────────────────────────────────
# Tenor: https://developers.google.com/tenor/guides/quickstart
# TENOR_API_KEY=
# Giphy: https://developers.giphy.com/
# GIPHY_API_KEY=

# ─── Enrichment APIs (optional — soft-fail when missing) ────────────
# Fanart.tv stills (needs TVDB id per title)
# FANART_API_KEY=
# SauceNAO reverse image
# SAUCENAO_API_KEY=
# Simkl id bridge
# SIMKL_CLIENT_ID=
# Watchmode streaming availability
# WATCHMODE_API_KEY=
# WATCHMODE_DEFAULT_REGION=US
# AnimeSchedule
# ANIMESCHEDULE_API_KEY=
# AniDB (client name + version required by their API)
# ANIDB_CLIENT=
# ANIDB_CLIENTVER=1
